import cv2
import numpy as np

def generate_triangles(points, width, height):

    rect = (0, 0, width, height)
    subdiv = cv2.Subdiv2D(rect)

    for p in points:
        subdiv.insert((int(p[0]), int(p[1])))

    triangle_list = subdiv.getTriangleList()

    triangles = []

    for t in triangle_list:

        pt1 = (int(round(t[0])), int(round(t[1])))
        pt2 = (int(round(t[2])), int(round(t[3])))
        pt3 = (int(round(t[4])), int(round(t[5])))

        # Reject triangles outside image
        if not (
            0 <= pt1[0] < width and 0 <= pt1[1] < height and
            0 <= pt2[0] < width and 0 <= pt2[1] < height and
            0 <= pt3[0] < width and 0 <= pt3[1] < height
        ):
            continue

        # Reject huge triangles
        d12 = np.linalg.norm(np.array(pt1) - np.array(pt2))
        d23 = np.linalg.norm(np.array(pt2) - np.array(pt3))
        d31 = np.linalg.norm(np.array(pt3) - np.array(pt1))

        max_edge = max(d12, d23, d31)

        if max_edge > 80:
            continue

        triangles.append([pt1, pt2, pt3])

    return triangles